  "published": "2026-09-19",
  "title": "mcp-server-git path and argument flaws chain with Filesystem MCP to code execution",
  "summary": "Three flaws in the reference Git MCP server - a repository path restriction bypass, unrestricted git_init, and argument injection in git_diff - let injected content read or overwrite files the server can reach. Alone the impact is file access. With the Filesystem MCP server also connected, a crafted .git/config yields code execution. The trigger is any content the agent reads.",
  "affected": {
    "all": [
      {
        "tool": {
          "source": "pkg:pypi/mcp-server-git",
          "versions": [
            "<2025.12.18"
          ]
        }
      },
      {
        "tool": {
          "source": "pkg:npm/@modelcontextprotocol/server-filesystem"
        }
      },
      {
        "toolset": {
          "capabilities": {
            "includesAny": [
              "ingests-untrusted-content"
            ]
          }
        }
      }
    ]
  },
  "severity": "high",
  "impact": [
    "code-execution",
    "integrity"
  ],
  "attackVector": "indirect-prompt-injection",
  "fixedBy": [
    {
      "upgrade": {
        "component": "tool",
        "name": "mcp-server-git",
        "version": "2025.12.18"
      }
    }
  ],
